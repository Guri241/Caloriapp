// ==========================================
// ダイエットアプリ Prismaスキーマ
// DB: Neon PostgreSQL
// ==========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------
// Enum定義
// ------------------------------------------

// 活動レベル（消費カロリー計算の基礎係数に利用）
enum ActivityLevel {
  SEDENTARY // 座り仕事中心・運動なし
  LIGHT // 軽い運動（週1-3回）
  MODERATE // 中程度の運動（週3-5回）
  ACTIVE // 高強度の運動（週6-7回）
  VERY_ACTIVE // 激しい運動・肉体労働
}

// 食事区分
enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

// ヘルスケア連携元
enum HealthSource {
  APPLE_HEALTH
  GOOGLE_FIT
}

// ヘルスケアデータ種別
enum HealthDataType {
  STEPS // 歩数
  ACTIVE_CALORIES // 活動消費カロリー
  WEIGHT // 体重（ヘルスケア側で記録されたもの）
}

// ------------------------------------------
// User: ユーザープロフィール
// ------------------------------------------
model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String // 簡易JWT認証用のハッシュ
  name          String?
  birthDate     DateTime?
  gender        String? // 'male' | 'female' | 'other' などフリー文字列で保持
  heightCm      Float? // 身長（BMI計算等に使用）
  activityLevel ActivityLevel @default(MODERATE)

  // 紹介プログラム（広告費0で獲得を回すための成長ループ）
  referralCode       String? @unique // このユーザーが他人に配るコード
  referredByCode     String? // 登録時に使われた他人のコード
  referralCreditDays Int     @default(0) // 紹介で獲得した無料利用日数の累計

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  weightLogs     WeightLog[]
  mealLogs       MealLog[]
  exerciseLogs   ExerciseLog[]
  goals          Goal[]
  healthLogs     HealthLog[]
  dailySummaries DailySummary[]
  foods          Food[] // ユーザーが自前登録した食品マスタ

  subscription  Subscription?
  usageCounters UsageCounter[]
  photoAnalyses MealPhotoAnalysis[]

  @@map("users")
}

// ------------------------------------------
// WeightLog: 体重・体脂肪記録
// ------------------------------------------
model WeightLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  weightKg   Float
  bodyFatPct Float? // 体脂肪率（%）
  recordedAt DateTime // 記録日時（体重計の測定時刻）
  source     String   @default("manual") // 'manual' | 'apple_health' | 'google_fit'

  createdAt DateTime @default(now())

  @@index([userId, recordedAt])
  @@map("weight_logs")
}

// ------------------------------------------
// Food: 食品マスタ
// 外部DB（文科省食品成分DB/USDA）取込分とユーザー自前登録分を共存させる
// ------------------------------------------
model Food {
  id     String  @id @default(cuid())
  userId String? // nullなら共通マスタ（外部DB取込分）、値ありならユーザー自前登録
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name         String
  brand        String? // メーカー名・商品名（任意）
  caloriesKcal Float // 100gあたりのカロリー
  proteinG     Float // 100gあたりのたんぱく質(g)
  fatG         Float // 100gあたりの脂質(g)
  carbsG       Float // 100gあたりの炭水化物(g)
  servingSizeG Float?  @default(100) // 基準量（g）。100g基準以外の登録も可能にする

  externalSource String? // 'mext' | 'usda' | null（自前登録）
  externalId     String? // 外部DB側のID（重複取込防止用）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mealLogItems MealLogItem[]

  @@index([name])
  @@unique([externalSource, externalId])
  @@map("foods")
}

// ------------------------------------------
// MealLog: 食事記録（1回の食事＝1レコード）
// 実際の食品明細はMealLogItemに分離（1食で複数品目を記録できるように）
// ------------------------------------------
model MealLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  mealType MealType
  loggedAt DateTime // 食事をとった日時
  memo     String?

  createdAt DateTime @default(now())

  items MealLogItem[]

  @@index([userId, loggedAt])
  @@map("meal_logs")
}

// ------------------------------------------
// MealLogItem: 食事の品目明細
// Foodマスタ参照 or 手入力（foodIdがnullの場合は手入力扱い）
// ------------------------------------------
model MealLogItem {
  id        String  @id @default(cuid())
  mealLogId String
  mealLog   MealLog @relation(fields: [mealLogId], references: [id], onDelete: Cascade)

  foodId String?
  food   Food?   @relation(fields: [foodId], references: [id])

  // 手入力時に使用（foodIdがnullの場合は必須）
  customName String?
  amountG    Float // 実際に食べた量（g）

  // 計算済みの実摂取値（Food参照時はamountGとFoodの100gあたり値から自動計算してここに保存）
  caloriesKcal Float
  proteinG     Float
  fatG         Float
  carbsG       Float

  createdAt DateTime @default(now())

  @@map("meal_log_items")
}

// ------------------------------------------
// ExerciseLog: 運動記録
// ------------------------------------------
model ExerciseLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  exerciseName    String // 例: 'ランニング', '筋トレ'
  durationMinutes Int?
  caloriesBurned  Float
  performedAt     DateTime
  source          String   @default("manual") // 'manual' | 'apple_health' | 'google_fit'

  createdAt DateTime @default(now())

  @@index([userId, performedAt])
  @@map("exercise_logs")
}

// ------------------------------------------
// Goal: 目標設定
// ------------------------------------------
model Goal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  targetWeightKg Float
  startWeightKg  Float // 目標設定時点の体重（進捗率計算の基準）
  startDate      DateTime
  targetDate     DateTime?
  isActive       Boolean   @default(true) // 現在有効な目標かどうか（複数目標の履歴を残せるように）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isActive])
  @@map("goals")
}

// ------------------------------------------
// HealthLog: HealthKit/Google Fit同期データ
// ------------------------------------------
model HealthLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  source     HealthSource
  dataType   HealthDataType
  value      Float // 歩数なら歩数、カロリーならkcal、体重ならkg
  recordedAt DateTime // ヘルスケア側の記録日時
  syncedAt   DateTime       @default(now()) // アプリに同期された日時

  // 同一データの重複同期を防ぐための一意制約
  @@unique([userId, source, dataType, recordedAt])
  @@index([userId, recordedAt])
  @@map("health_logs")
}

// ------------------------------------------
// DailySummary: 日次集計キャッシュ
// 毎日バッチ or 記録更新時に再計算して保存する想定
// ------------------------------------------
model DailySummary {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date DateTime // 集計対象日（時刻部分は00:00に正規化して保存）

  totalIntakeKcal Float @default(0) // 摂取カロリー合計
  totalBurnedKcal Float @default(0) // 消費カロリー合計（運動＋ヘルスケア活動消費）
  netCaloriesKcal Float @default(0) // 摂取 - 消費
  totalProteinG   Float @default(0)
  totalFatG       Float @default(0)
  totalCarbsG     Float @default(0)

  latestWeightKg Float? // その日時点の最新体重（あれば）

  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@map("daily_summaries")
}

// ==========================================
// 収益化（サブスクリプション）関連
// ==========================================

// 契約プラン。無料/有料の2階層に絞る（選択肢を増やすと転換率が落ちるため）
enum PlanTier {
  FREE
  PRO
}

// 課金間隔。年額は月額比で約2ヶ月分の割引を付け、LTVと前払いキャッシュを最大化する
enum BillingInterval {
  MONTH
  YEAR
}

// Stripeのsubscription.statusに対応させる
enum SubscriptionStatus {
  TRIALING // 無料トライアル中
  ACTIVE // 課金中
  PAST_DUE // 決済失敗・リトライ中（機能は猶予期間中のみ維持）
  CANCELED // 解約済み（期末を過ぎた）
  INCOMPLETE // 初回決済未完了
}

// 従量制限をかける対象機能
enum MeteredFeature {
  AI_PHOTO_ANALYSIS // AI写真解析（原価が乗る唯一の機能）
  FOOD_SEARCH // USDA食品検索
}

// ------------------------------------------
// Subscription: ユーザーの課金状態
// Stripeを正とし、Webhookでこのテーブルへ射影する
// ------------------------------------------
model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tier     PlanTier           @default(FREE)
  status   SubscriptionStatus @default(INCOMPLETE)
  interval BillingInterval?

  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  stripePriceId        String?

  currentPeriodEnd  DateTime? // この時刻までは解約後も機能を維持する
  cancelAtPeriodEnd Boolean   @default(false)
  trialEndsAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

// ------------------------------------------
// UsageCounter: 従量機能の月次使用量
// 無料枠の上限判定と、有料ユーザーの原価監視の両方に使う
// ------------------------------------------
model UsageCounter {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  feature     MeteredFeature
  periodStart DateTime // 集計期間の開始（月初00:00 UTCに正規化）
  count       Int            @default(0)

  updatedAt DateTime @updatedAt

  @@unique([userId, feature, periodStart])
  @@map("usage_counters")
}

// ------------------------------------------
// MealPhotoAnalysis: AI写真解析の結果
// 再解析なしで再利用でき、原価の実測値（inputTokens等）も残す
// ------------------------------------------
model MealPhotoAnalysis {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 解析結果（品目配列をJSONで保持。確定するとMealLogItemへ書き出す）
  items      Json
  confidence Float? // モデルの自己申告確信度 0.0-1.0
  note       String? // 「白米の量が推定」など、ユーザーに見せる注記

  model        String? // 解析に使ったモデルID
  inputTokens  Int? // 原価の実測用
  outputTokens Int?

  mealLogId String? // 確定してMealLogを作った場合の紐付け

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("meal_photo_analyses")
}
