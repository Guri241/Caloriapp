# Neon PostgreSQL 接続文字列 (pooled)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/caloriapp?sslmode=require"
# Neon direct connection (prisma migrate用。Neonのpoolerを使わない直接接続)
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/caloriapp?sslmode=require"

# JWTの署名シークレット（openssl rand -base64 32 などで生成）
JWT_SECRET="change-me-to-a-long-random-secret"

# USDA FoodData Central API Key (https://fdc.nal.usda.gov/api-key-signup.html)
USDA_API_KEY="your-usda-api-key"

# --- 収益化まわり ---

# LP・料金ページ・Stripeの戻り先に使う公開URL（末尾スラッシュなし）
APP_URL="http://localhost:3000"

# Stripe（https://dashboard.stripe.com/apikeys）
STRIPE_SECRET_KEY="sk_test_xxx"
# stripe listen --forward-to localhost:3000/api/billing/webhook で発行される値
STRIPE_WEBHOOK_SECRET="whsec_xxx"
# Stripeダッシュボードで作成したPrice ID（JPY・継続課金）
STRIPE_PRICE_ID_MONTHLY="price_xxx_monthly"
STRIPE_PRICE_ID_YEARLY="price_xxx_yearly"

# AI写真解析（https://console.anthropic.com/）
ANTHROPIC_API_KEY="sk-ant-xxx"
# 解析に使うモデル。未設定ならclaude-opus-5。原価と精度のバランスはMONETIZATION.md参照
# FOOD_VISION_MODEL="claude-opus-5"
