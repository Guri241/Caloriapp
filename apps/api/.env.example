# Neon PostgreSQL 接続文字列 (pooled)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/caloriapp?sslmode=require"
# Neon direct connection (prisma migrate用。Neonのpoolerを使わない直接接続)
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/caloriapp?sslmode=require"

# JWTの署名シークレット（openssl rand -base64 32 などで生成）
JWT_SECRET="change-me-to-a-long-random-secret"

# USDA FoodData Central API Key (https://fdc.nal.usda.gov/api-key-signup.html)
USDA_API_KEY="your-usda-api-key"
